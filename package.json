{
  "name": "dsh-remote-hosts",
  "version": "1.2.0",
  "description": "Panel of remote machines: connect one and work on it through its own DSH web GUI, as the logged-in account.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "remote",
    "ssh",
    "teleport",
    "tsh"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lqfool/dsh-remote-hosts.git"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
